{
  "name": "clawfabric-builder",
  "version": "0.1.0",
  "private": true,
  "description": "A focused desktop AI builder for small tools and projects.",
  "author": {
    "name": "ClawFabric"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "set BUILDER_RENDERER_URL=http://127.0.0.1:5173&& electron .",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:boundaries": "node --test tests/*.test.cjs",
    "test": "npm run test:unit && npm run test:boundaries",
    "build": "npm run typecheck && vite build",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:packaged-launch": "node scripts/verify-packaged-launch-smoke.cjs",
    "verify:packaged-canary": "node scripts/verify-packaged-canary-default.cjs",
    "verify:packaged-live-preview": "node scripts/verify-packaged-live-preview-canary.cjs",
    "verify:packaged-plan-mode": "node scripts/verify-packaged-plan-mode-canary.cjs",
    "verify:packaged-active-followup": "node scripts/verify-packaged-active-followup-canary.cjs",
    "verify:packaged-experience": "npm run verify:packaged-canary && npm run verify:packaged-plan-mode && npm run verify:packaged-active-followup && npm run verify:packaged-live-preview",
    "verify:packaged-canary:deepseek": "node scripts/verify-deepseek-packaged-canary.cjs",
    "verify:packaged-harness:deepseek": "node scripts/verify-deepseek-packaged-harness-canary.cjs",
    "verify:packaged-agent-browser-cancellation": "node scripts/verify-packaged-agent-browser-cancellation-canary.cjs",
    "verify:packaged-plan-mode:deepseek": "node scripts/verify-deepseek-packaged-plan-canary.cjs",
    "verify:packaged-e2e:deepseek": "node scripts/verify-deepseek-packaged-e2e-gate.cjs",
    "verify:packaged-agent-history:deepseek": "node scripts/verify-deepseek-packaged-agent-history-e2e-canary.cjs",
    "verify:packaged-harness:deepseek:soak": "node scripts/verify-deepseek-packaged-harness-soak.cjs",
    "prepare:harness-runtime": "node scripts/prepare-builder-harness-runtime.cjs",
    "stage:harness-runtime": "node scripts/stage-builder-harness-runtime.cjs",
    "verify:harness-coding-loop": "node scripts/verify-builder-harness-coding-loop.cjs",
    "verify:harness-compaction": "node scripts/verify-builder-harness-coding-loop.cjs --compaction",
    "measure:a0:event-projection": "node scripts/measure-builder-event-projection-baseline.cjs",
    "verify:packaged-harness-coding-loop": "node scripts/verify-packaged-harness-coding-loop.cjs",
    "verify:packaged-harness-compaction": "node scripts/verify-packaged-harness-compaction-canary.cjs",
    "verify:packaged-harness-ui": "node scripts/verify-packaged-harness-ui-canary.cjs",
    "verify:packaged-harness-stress": "node scripts/verify-packaged-harness-stress-canary.cjs",
    "verify:packaged-harness-failure": "node scripts/verify-packaged-harness-failure-canary.cjs",
    "verify:release": "npm run lint && npm run test:unit && npm run test:boundaries && npm run dist && npm run verify:packaged-launch && npm run verify:packaged-canary && npm run verify:packaged-plan-mode && npm run verify:packaged-harness-ui && npm run verify:packaged-harness-compaction && npm run verify:packaged-harness-failure",
    "verify:release:deepseek": "npm run verify:release && npm run verify:packaged-harness:deepseek",
    "pack": "npm run build && npm run stage:harness-runtime && electron-builder --dir && npm run verify:package",
    "dist": "npm run build && node scripts/build-windows-release.cjs && npm run verify:package"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "lucide-react": "^1.6.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.clawfabric.builder",
    "productName": "ClawFabric Builder",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "scripts/verify-builder-harness-coding-loop.cjs",
      "package.json",
      "!node_modules/style-to-js/src/*.test.ts"
    ],
    "asarUnpack": [
      "electron/builder-packaged-check-script-worker.cjs",
      "electron/builder-packaged-check-runtime-contract.cjs",
      "electron/harness/**/*",
      "node_modules/@npmcli/promise-spawn/**/*",
      "node_modules/which/**/*",
      "node_modules/isexe/**/*",
      "node_modules/dugite/git/**/*",
      "node_modules/dugite/LICENSE",
      "node_modules/dugite/git/LICENSE.txt"
    ],
    "extraResources": [
      {
        "from": ".release-runtime/harness-runtime.asar",
        "to": "harness-runtime.asar"
      },
      {
        "from": ".release-runtime/harness-runtime-manifest.json",
        "to": "harness-runtime-manifest.json"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@npmcli/promise-spawn": "9.0.1",
    "dugite": "3.2.2"
  }
}
